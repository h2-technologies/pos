// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id String @id
  synnexNumber String?
  manufacturer String
  productName String
  sku String @unique
  extendedPrice Float
  msrp Float
  shipping Float
  price Float
  category String?
}

